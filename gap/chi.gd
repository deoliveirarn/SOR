#
# RoccoSidki: Rocco's nu(G), Sidki's chi(G) and related groups
#
# chi(G) (Sidki): declarations.
#
#! @Chapter The weak commutativity group
#!
#! @Section Construction
#!
#! Let $G$ be a group and $G^\psi$ an isomorphic copy of $G$, with
#! $\psi : G \to G^\psi$ an isomorphism. Sidki's weak commutativity group is
#! $$\chi(G) = \langle G, G^\psi \mid [g, g^\psi] = 1 \ \forall g \in G \rangle.$$
#! Here it is computed as the quotient of the free product $G * G$ by these
#! relations, keeping the two embeddings of $G$.

#! @Description
#!   Returns $\chi(G)$ for a group <A>G</A> given in any representation
#!   (permutation, pc, pcp, matrix or finitely presented) that is finite
#!   solvable, finite perfect, finite or polycyclic generated by two elements
#!   with trivial Schur multiplier, or infinite polycyclic generated by two
#!   elements; the method for each case is in the section
#!   <Q>Strategy by class of groups</Q>. The result is a pc group, a pcp group
#!   or a subgroup of a direct product. <C>Embedding(</C><A>C</A><C>, 1)</C> and
#!   <C>Embedding(</C><A>C</A><C>, 2)</C> are the embeddings of $G$ and of
#!   $G^\psi$ into it, and <Ref Attr="SidkiPsi" Label="for IsGroup"/> is $\psi$.
#! @Arguments G
#! @Returns a group
DeclareAttribute( "SidkiChiGroup", IsGroup );

#! @Description
#!   For a group <A>C</A> returned by <Ref Attr="SidkiChiGroup" Label="for IsGroup"/>, the
#!   isomorphism $\psi$ from the first copy of $G$ in <A>C</A> to the second.
#! @Arguments C
#! @Returns an isomorphism of groups
DeclareAttribute( "SidkiPsi", IsGroup );

#! @BeginExampleSession
#! gap> G := SmallGroup( 8, 4 );;   # the quaternion group
#! gap> C := SidkiChiGroup( G );;
#! gap> Size( C );
#! 128
#! gap> H := Image( Embedding( C, 1 ) );;  Hpsi := Image( Embedding( C, 2 ) );;
#! gap> Size( H ) = 8 and Size( Hpsi ) = 8;
#! true
#! gap> ForAll( G, g -> IsOne( Comm( g^Embedding( C, 1 ), g^Embedding( C, 2 ) ) ) );
#! true
#! gap> P := Image( IsomorphismPermGroup( G ) );;   # same group, other representation
#! gap> Size( SidkiChiGroup( P ) );
#! 128
#! @EndExampleSession

#! @Section Polycyclic groups
#!
#! For a polycyclic group $G$, the group
#! $\tau(G) = \nu(G)/\Delta(G)$ of Dias and Rocco (see
#! <Ref Oper="RoccoTauGroup" Label="for IsGroup, IsInt"/> with $q = 0$) is
#! isomorphic to $\chi(G)/R(G)$, the copies $G$ and $G^\varphi$ going to $G$ and
#! $G^\psi$. If $G$ is generated by two elements then $R(G) = 1$
#! (Kochloukova and Mendonça 2021, Lemma 9.3), so $\tau(G)$ is a consistent
#! polycyclic presentation of $\chi(G)$ itself, also for infinite $G$.

#! @Description
#!   Returns $\chi(G)/R(G)$ for a polycyclic group <A>G</A> (finite solvable in
#!   any representation, or a pcp group), as the pcp group $\tau(G)$, with
#!   <C>Embedding</C> and the subgroups of <Ref Attr="SidkiD" Label="for IsGroup"/>
#!   and the following ones available. For a pcp group with at most two
#!   generators, <Ref Attr="SidkiChiGroup" Label="for IsGroup"/> uses this.
#! @Arguments G
#! @Returns a pcp group
DeclareAttribute( "SidkiChiModRGroup", IsGroup );

#! @BeginExampleSession
#! gap> C := SidkiChiGroup( DihedralPcpGroup( 0 ) );;   # infinite dihedral group
#! gap> IsFinite( C );
#! false
#! gap> Size( SidkiD( C ) ) = infinity and IsTrivial( SidkiR( C ) );
#! true
#! gap> Size( SidkiChiModRGroup( SmallGroup( 32, 34 ) ) ) =
#! >    Size( SidkiChiGroup( SmallGroup( 32, 34 ) ) ) / 4;   # |R| = 4 here
#! true
#! @EndExampleSession

#! @Section The quotient chi(G)/W(G) inside G x G x G
#!
#! Sidki (1980): the homomorphism $\rho : \chi(G) \to G \times G \times G$,
#! $g \mapsto (g, g, 1)$, $g^\psi \mapsto (1, g, g)$, has kernel $W(G)$; its image
#! is denoted $T(G)$. Rocco (1982): $W(G)/R(G) \cong M(G)$, the Schur
#! multiplier. Hence $\chi(G) \cong T(G)$ when $R(G) = 1$ and $M(G) = 1$, in
#! particular when $G$ is generated by two elements and $M(G) = 1$; this holds
#! for groups of any kind, solvable or not.

#! @Description
#!   Returns $T(G) \cong \chi(G)/W(G)$, the subgroup of $G \times G \times G$
#!   generated by $(g, g, 1)$ and $(1, g, g)$, $g \in G$, with the embeddings
#!   $g \mapsto (g, g, 1)$ and $g \mapsto (1, g, g)$. For any group <A>G</A>.
#!   <Ref Attr="SidkiChiGroup" Label="for IsGroup"/> uses it when <A>G</A> is
#!   generated by two elements and has trivial Schur multiplier.
#! @Arguments G
#! @Returns a group
DeclareAttribute( "SidkiChiModWGroup", IsGroup );

#! @BeginExampleSession
#! gap> G := PSL( 2, 8 );;   # not solvable; 2-generated, M(G) = 1
#! gap> C := SidkiChiGroup( G );;
#! gap> Size( C ) = Size( G )^3;
#! true
#! gap> ForAll( GeneratorsOfGroup( G ), g ->
#! >      IsOne( Comm( g^Embedding( C, 1 ), g^Embedding( C, 2 ) ) ) );
#! true
#! @EndExampleSession

# Internal record kept with the result: the input group and the embeddings.
DeclareGlobalFunction( "RS_ChiByFreeProduct" );
DeclareAttribute( "RS_ChiData", IsGroup );
