#
# RoccoSidki: Rocco's nu(G), Sidki's chi(G) and related groups
#
# chi(G) (Sidki): implementations.
#

InstallMethod( SidkiChiGroup, "for a finite solvable group, by the free product",
    [ IsGroup ],
    G -> RS_ChiByFreeProduct( G ) );

InstallGlobalFunction( RS_ChiByFreeProduct, function( G )
    local data, r, C;
    if not IsFinite( G ) or IsTrivial( G ) or not IsSolvableGroup( G ) then
        Error( "SidkiChiGroup: for now <G> must be a nontrivial finite solvable group" );
    fi;
    data := RS_FreeProductQuotient( G, 2,
              e -> List( Difference( AsList( G ), [ One( G ) ] ),
                         g -> Comm( Image( e[1], g ), Image( e[2], g ) ) ) );
    if IsPGroup( G ) then
        # chi(G) is a finite p-group (Sidki), hence its largest p-quotient.
        r := RS_PQuotientWithEmbeddings( G, data, PrimePGroup( G ) );
    else
        # chi(G) is finite solvable, with the primes of |G| (Sidki).
        r := RS_SolvableQuotientWithEmbeddings( G, data, Set( Factors( Size( G ) ) ) );
    fi;
    C := r.group;
    SetRS_ChiData( C, rec( group := G, emb := r.emb ) );
    return C;
end );

# chi(G)/R(G) = tau(G) (Dias-Rocco, q = 0), with the embeddings.
InstallMethod( SidkiChiModRGroup, "for a polycyclic group, via tau(G)",
    [ IsGroup ],
    function( G )
    local T, C;
    T := RoccoTauGroup( G, 0 );
    # a fresh group object, so that it carries only the chi data
    C := PcpGroupByCollector( Collector( T ) );
    SetRS_ChiData( C, rec( group := G, modR := true,
        emb := List( [ 1, 2 ], i -> GroupHomomorphismByImagesNC( G, C,
                   GeneratorsOfGroup( G ),
                   List( GeneratorsOfGroup( G ), g -> MappedVector(
                       Exponents( Image( Embedding( T, i ), g ) ),
                       GeneratorsOfPcp( Pcp( C ) ) ) ) ) ) ) );
    return C;
end );

# T(G) <= G x G x G, image of chi(G) with kernel W(G) (Sidki 1980).
InstallMethod( SidkiChiModWGroup, "for a group, inside G x G x G",
    [ IsGroup ],
    function( G )
    local P, e, gens, T;
    P := DirectProduct( G, G, G );
    e := List( [ 1 .. 3 ], i -> Embedding( P, i ) );
    gens := GeneratorsOfGroup( G );
    T := Subgroup( P, Concatenation(
             List( gens, g -> Image( e[1], g ) * Image( e[2], g ) ),
             List( gens, g -> Image( e[2], g ) * Image( e[3], g ) ) ) );
    SetRS_ChiData( T, rec( group := G, modW := true,
        emb := [ GroupHomomorphismByImagesNC( G, T, gens,
                     List( gens, g -> Image( e[1], g ) * Image( e[2], g ) ) ),
                 GroupHomomorphismByImagesNC( G, T, gens,
                     List( gens, g -> Image( e[2], g ) * Image( e[3], g ) ) ) ] ) );
    return T;
end );

# true if G is generated by two elements (sufficient tests; for finite
# solvable groups exact, by MinimalGeneratingSet).
BindGlobal( "RS_IsTwoGenerated", function( G )
    local cand;
    if Length( GeneratorsOfGroup( G ) ) <= 2 then return true; fi;
    if IsFinite( G ) then
        if IsSolvableGroup( G ) then
            return Length( MinimalGeneratingSet( G ) ) <= 2;
        fi;
        return Length( SmallGeneratingSet( G ) ) <= 2;
    fi;
    cand := Set( Concatenation( GeneratorsOfGroup( G ), GeneratorsOfPcp( Pcp( G ) ) ) );
    return ForAny( Combinations( cand, 2 ), c -> Subgroup( G, c ) = G );
end );

# chi(G) = T(G) when G is 2-generated (R = 1, Kochloukova-Mendonca 2021,
# Lemma 9.3) and M(G) = 1 (W/R ~ M(G), Rocco 1982).  Tried first.
InstallMethod( SidkiChiGroup, "for a 2-generated group with trivial multiplier, as T(G)",
    [ IsGroup ], 10,
    function( G )
    if IsTrivial( G ) or IsFpGroup( G ) or not ( IsFinite( G ) or IsPcpGroup( G ) ) then
        TryNextMethod();
    fi;
    if not RS_IsTwoGenerated( G ) or AbelianInvariantsMultiplier( G ) <> [ ] then
        TryNextMethod();
    fi;
    Info( InfoRoccoSidki, 1, "chi(G): 2-generated, M(G) = 1, chi(G) = T(G)" );
    return SidkiChiModWGroup( G );
end );

# Infinite polycyclic G generated by at most two elements: R(G) = 1
# (Kochloukova-Mendonca 2021, Lemma 9.3), so chi(G) = tau(G).
InstallMethod( SidkiChiGroup, "for a 2-generated pcp group, via tau(G)",
    [ IsPcpGroup ],
    function( G )
    if IsFinite( G ) then
        TryNextMethod();
    fi;
    if not RS_IsTwoGenerated( G ) then
        Error( "SidkiChiGroup: for an infinite pcp group, for now <G> must be ",
               "generated by two elements (then R(G) = 1); ",
               "SidkiChiModRGroup gives chi(G)/R(G)" );
    fi;
    return SidkiChiModRGroup( G );
end );

InstallMethod( Embedding, "for chi(G) of RoccoSidki",
    [ IsGroup and HasRS_ChiData, IsPosInt ],
    function( C, i )
    if i > 2 then
        Error( "Embedding: chi(G) has only two copies of G" );
    fi;
    return RS_ChiData( C ).emb[ i ];
end );

InstallMethod( SidkiPsi, "for chi(G) of RoccoSidki",
    [ IsGroup and HasRS_ChiData ],
    function( C )
    local d, gens;
    d := RS_ChiData( C );
    gens := GeneratorsOfGroup( d.group );
    return GroupHomomorphismByImagesNC( Image( d.emb[1] ), Image( d.emb[2] ),
               List( gens, g -> Image( d.emb[1], g ) ),
               List( gens, g -> Image( d.emb[2], g ) ) );
end );
