#
# SOR: Rocco's nu(G), Sidki's chi(G) and related groups
#
# chi(G, S; m): weak commutativity imposed only on products of generators
# (implementations).
#

InstallGlobalFunction( SidkiChiHatGroup, function( arg )
    local G, m, S, prods, Si, i, data, emb;
    G := arg[1];  m := arg[2];
    if Length( arg ) > 2 then S := arg[3]; else S := GeneratorsOfGroup( G ); fi;
    if not IsPosInt( m ) then
        Error( "SidkiChiHatGroup: <m> must be a positive integer" );
    fi;
    if not IsFinite( G ) or IsTrivial( G ) then
        Error( "SidkiChiHatGroup: <G> must be a nontrivial finite group" );
    fi;
    if Subgroup( G, S ) <> G then
        Error( "SidkiChiHatGroup: <S> must generate <G>" );
    fi;
    # S u S^2 u ... u S^m, without the identity
    prods := [];  Si := [ One( G ) ];
    for i in [ 1 .. m ] do
        Si := Set( ListX( Si, S, \* ) );
        UniteSet( prods, Si );
    od;
    prods := Filtered( prods, a -> a <> One( G ) );
    Info( InfoSOR, 1, "chi(G,S;", m, "): ", Length( prods ), " elements" );
    data := RS_FreeProductQuotient( G, 2, e -> List( prods,
                a -> Comm( Image( e[1], a ), Image( e[2], a ) ) ) );
    emb := List( data.emb, e -> GroupHomomorphismByImagesNC( G, data.Q,
               GeneratorsOfGroup( G ),
               List( GeneratorsOfGroup( G ), g -> Image( data.nat, Image( e, g ) ) ) ) );
    SetRS_ChiHatData( data.Q, rec( group := G, S := S, m := m, emb := emb ) );
    return data.Q;
end );

InstallMethod( Embedding, "for chi(G,S;m) of SOR",
    [ IsGroup and HasRS_ChiHatData, IsPosInt ],
    function( C, i )
    if i > 2 then
        Error( "Embedding: there are only 2 copies of G" );
    fi;
    return RS_ChiHatData( C ).emb[ i ];
end );

# The projection chi(G,S;m) -> X, X = SidkiChiGroup( G, method ): each copy of
# G to the corresponding copy.  C is generated by the images of the two copies,
# and chi(G) has the same generators and more relations, so this is a
# homomorphism by construction.  It is checked only when X is not finitely
# presented: in a finitely presented X the check needs coset enumeration.
BindGlobal( "RS_ChiHatProjection", function( C, method )
    local d, X, gens, src, img;
    d := RS_ChiHatData( C );
    X := SidkiChiGroup( d.group, method );
    gens := GeneratorsOfGroup( d.group );
    src := Concatenation( List( gens, g -> Image( d.emb[1], g ) ),
                          List( gens, g -> Image( d.emb[2], g ) ) );
    img := Concatenation( List( gens, g -> Image( Embedding( X, 1 ), g ) ),
                          List( gens, g -> Image( Embedding( X, 2 ), g ) ) );
    if IsFpGroup( X ) then
        return GroupHomomorphismByImagesNC( C, X, src, img );
    fi;
    return GroupHomomorphismByImages( C, X, src, img );
end );

InstallMethod( SidkiChiHatProjection, "for chi(G,S;m) of SOR, onto the fp chi(G)",
    [ IsGroup and HasRS_ChiHatData ],
    C -> RS_ChiHatProjection( C, "fp" ) );

InstallMethod( SidkiChiHatProjection, "for chi(G,S;m) of SOR and a method",
    [ IsGroup and HasRS_ChiHatData, IsString ],
    RS_ChiHatProjection );
