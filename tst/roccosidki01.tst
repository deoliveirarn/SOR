gap> START_TEST("roccosidki01.tst");

# doc/_Chapter_The_weak_commutativity_group.xml:40-53
gap> G := SmallGroup( 8, 4 );;   # the quaternion group
gap> C := SidkiChiGroup( G );;
gap> Size( C );
128
gap> H := Image( Embedding( C, 1 ) );;  Hpsi := Image( Embedding( C, 2 ) );;
gap> Size( H ) = 8 and Size( Hpsi ) = 8;
true
gap> ForAll( G, g -> IsOne( Comm( g^Embedding( C, 1 ), g^Embedding( C, 2 ) ) ) );
true
gap> P := Image( IsomorphismPermGroup( G ) );;   # same group, other representation
gap> Size( SidkiChiGroup( P ) );
128

# doc/_Chapter_The_weak_commutativity_group.xml:99-103
gap> C := SidkiChiGroup( SmallGroup( 8, 3 ) );;   # the dihedral group
gap> List( [ SidkiD, SidkiL, SidkiW, SidkiR ], f -> Size( f( C ) ) );
[ 4, 32, 2, 1 ]

#
gap> STOP_TEST("roccosidki01.tst", 1);
